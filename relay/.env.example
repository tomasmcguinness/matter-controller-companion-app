# The APNs auth key (.p8) from the Apple Developer portal, under Keys.
APNS_KEY_PATH=./AuthKey_XXXXXXXXXX.p8
APNS_KEY_ID=XXXXXXXXXX
APNS_TEAM_ID=XXXXXXXXXX

# The MCC app's bundle id.
APNS_TOPIC=com.tomasmcguinness.matter-controller-companion-v1

# Created with `npm run add-user -- <username>`.
USERS_FILE=./users.json

PORT=8080
