# APNs, for iPhones. Leave APNS_KEY_PATH unset if no one uses the iOS app.
# The APNs auth key (.p8) from the Apple Developer portal, under Keys.
APNS_KEY_PATH=./AuthKey_XXXXXXXXXX.p8
APNS_KEY_ID=XXXXXXXXXX
APNS_TEAM_ID=XXXXXXXXXX

# The MCC app's bundle id.
APNS_TOPIC=com.tomasmcguinness.matter-controller-companion-v1

# FCM, for Android phones. Leave it unset if no one uses the Android app.
# A service account key from the Firebase console (Project settings > Service accounts).
FCM_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Created with `npm run add-user -- <username>`.
USERS_FILE=./users.json

PORT=8080
